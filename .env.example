# Postgres connection string (Vercel Postgres, Supabase, Neon, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/social_media_dashboard?schema=public"

# Meta Graph API (Facebook + Instagram). Generate a long-lived Page access token.
# Docs: https://developers.facebook.com/docs/graph-api/
META_ACCESS_TOKEN=""
META_FACEBOOK_PAGE_ID=""
META_INSTAGRAM_BUSINESS_ID=""

# TikTok Business API. Requires an approved app and access token.
# Docs: https://business-api.tiktok.com/
TIKTOK_ACCESS_TOKEN=""
TIKTOK_BUSINESS_ID=""

# YouTube Data API v3. Use OAuth refresh token or API key (channel must be owned).
# Docs: https://developers.google.com/youtube/v3
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""

# Cron secret used to authorize /api/ingest and /api/reports/weekly endpoints
INGEST_SECRET="change-me"
