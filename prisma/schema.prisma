generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enums or Json type. We keep these as strings; the
// TypeScript layer in src/lib/scoring.ts enforces the allowed values.
// Platform: facebook | instagram | tiktok | youtube | all
// PostType: post | ad | reel | story
// Performance: bad | regular | good | excellent

model Campaign {
  id          String   @id @default(cuid())
  name        String   @unique
  purpose     String?
  audience    String?
  landingPage String?
  assets      String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]
}

model Post {
  id            String       @id @default(cuid())
  campaignId    String
  campaign      Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  platform      String
  postType      String       @default("post")
  externalId    String?
  permalink     String?
  caption       String?
  headline      String?
  cta           String?
  ctaLink       String?

  publishedAt   DateTime?
  reach         Int?
  viewers       Int?
  ctrLink       Float?
  landingCtr    Float?
  meetings      Int?         @default(0)
  performance   String?

  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  metrics       MetricSnapshot[]

  @@unique([platform, externalId])
  @@index([campaignId])
  @@index([platform, publishedAt])
}

model MetricSnapshot {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  capturedAt  DateTime @default(now())
  reach       Int?
  viewers     Int?
  likes       Int?
  comments    Int?
  shares      Int?
  saves       Int?
  clicks      Int?
  ctrLink     Float?
  landingCtr  Float?
  meetings    Int?

  @@index([postId, capturedAt])
}

model Alert {
  id         String   @id @default(cuid())
  postId     String?
  campaignId String?
  kind       String
  message    String
  severity   String
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@index([createdAt])
}

model Report {
  id          String   @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  kind        String
  summary     String
  payload     String   // JSON-encoded string (sqlite has no Json type)
  createdAt   DateTime @default(now())

  @@unique([kind, periodStart])
}
